# Environment configuration template for Pothole Detection & Municipal Reporting
# Copy this file to .env for local overrides (never commit .env to Git)

# Flask Secret Key used for session signing and CSRF protection
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=dev_secret_key_change_in_production_pothole_2026

# Flask Environment: development | production
FLASK_ENV=development
